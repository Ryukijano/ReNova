{
  "id": "tc_t1_structure_retrieval_2",
  "name": "Tier 1 - Structure Retrieval Coverage Case 2",
  "description": "Validates structure_retrieval under standard mock execution using Alzheimer's Disease.",
  "tier": 1,
  "milestone": "M6",
  "feature": "structure_retrieval",
  "input": {
    "disease": "Alzheimer's Disease",
    "args": {
      "--output-dir": "tests/output/tc_t1_structure_retrieval_2",
      "--mock": "true"
    },
    "env": {
      "ADMET_MOCK_PORT": "9012"
    },
    "mock_profile": "alzheimers"
  },
  "assertions": {
    "process": {
      "expected_exit_code": 0,
      "timeout_seconds": 600,
      "stdout_contains": [
        "Pipeline started",
        "Pipeline finished successfully"
      ],
      "stderr_excludes": [
        "Traceback (most recent call last):",
        "AssertionError:"
      ]
    },
    "outputs": [
      {
        "file_path": "tests/output/tc_t1_structure_retrieval_2/target_retriever_output.json",
        "format": "json",
        "json_rules": {
          "schema_validation": true,
          "min_items": 1,
          "check_file_paths_exist": "$[*].structure_path"
        }
      }
    ]
  }
}