{
  "id": "tc_t3_combo_5",
  "name": "Tier 3 - Combo Case 5 (structure_retrieval + chem_screening)",
  "description": "Validates the combined interaction and intermediate outputs of structure_retrieval and chem_screening.",
  "tier": 3,
  "milestone": "M6",
  "feature": "pipeline_integration",
  "input": {
    "disease": "Diabetes",
    "args": {
      "--output-dir": "tests/output/tc_t3_combo_5",
      "--mock": "true"
    },
    "env": {
      "ADMET_MOCK_PORT": "9035"
    },
    "mock_profile": "diabetes"
  },
  "assertions": {
    "process": {
      "expected_exit_code": 0,
      "timeout_seconds": 600,
      "stdout_contains": [
        "Pipeline started",
        "Pipeline finished successfully"
      ],
      "stderr_excludes": [
        "Traceback (most recent call last):",
        "AssertionError:"
      ]
    },
    "outputs": [
      {
        "file_path": "tests/output/tc_t3_combo_5/target_retriever_output.json",
        "format": "json",
        "json_rules": {
          "schema_validation": true,
          "min_items": 1,
          "check_file_paths_exist": "$[*].structure_path"
        }
      },
      {
        "file_path": "tests/output/tc_t3_combo_5/chem_screen_output.csv",
        "format": "csv",
        "csv_rules": {
          "required_columns": [
            "gene_symbol",
            "uniprot_id",
            "compound_id",
            "smiles",
            "relation",
            "value",
            "units"
          ],
          "min_row_count": 1,
          "column_validators": {
            "gene_symbol": {
              "type": "string"
            },
            "uniprot_id": {
              "type": "string"
            },
            "compound_id": {
              "type": "string"
            },
            "smiles": {
              "type": "smiles"
            },
            "value": {
              "type": "float",
              "min": 0.0
            },
            "units": {
              "type": "string"
            }
          }
        }
      }
    ]
  }
}