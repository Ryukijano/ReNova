{
  "id": "tc_t3_combo_4",
  "name": "Tier 3 - Combo Case 4 (target_identification + clinical_check)",
  "description": "Validates the combined interaction and intermediate outputs of target_identification and clinical_check.",
  "tier": 3,
  "milestone": "M6",
  "feature": "pipeline_integration",
  "input": {
    "disease": "Tuberculosis",
    "args": {
      "--output-dir": "tests/output/tc_t3_combo_4",
      "--mock": "true"
    },
    "env": {
      "ADMET_MOCK_PORT": "9034"
    },
    "mock_profile": "tuberculosis"
  },
  "assertions": {
    "process": {
      "expected_exit_code": 0,
      "timeout_seconds": 600,
      "stdout_contains": [
        "Pipeline started",
        "Pipeline finished successfully"
      ],
      "stderr_excludes": [
        "Traceback (most recent call last):",
        "AssertionError:"
      ]
    },
    "outputs": [
      {
        "file_path": "tests/output/tc_t3_combo_4/target_retriever_output.json",
        "format": "json",
        "json_rules": {
          "schema_validation": true,
          "min_items": 1
        }
      },
      {
        "file_path": "tests/output/tc_t3_combo_4/repurposing_candidate_report.csv",
        "format": "csv",
        "csv_rules": {
          "required_columns": [
            "compound_name",
            "compound_id",
            "smiles",
            "target_gene",
            "admet_score",
            "fda_approval_status",
            "clinical_trials_count",
            "adverse_events_count"
          ],
          "min_row_count": 1,
          "column_validators": {
            "compound_name": {
              "type": "string"
            },
            "compound_id": {
              "type": "string"
            },
            "smiles": {
              "type": "smiles"
            },
            "target_gene": {
              "type": "string"
            },
            "admet_score": {
              "type": "float"
            },
            "fda_approval_status": {
              "type": "string"
            },
            "clinical_trials_count": {
              "type": "int",
              "min": 0
            },
            "adverse_events_count": {
              "type": "int",
              "min": 0
            }
          }
        }
      }
    ]
  }
}