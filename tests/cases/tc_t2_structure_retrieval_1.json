{
  "id": "tc_t2_structure_retrieval_1",
  "name": "Tier 2 - Structure Retrieval Boundary Case 1",
  "description": "Boundary check with empty target / clinical trials mock database.",
  "tier": 2,
  "milestone": "M6",
  "feature": "structure_retrieval",
  "input": {
    "disease": "Empty Disease",
    "args": {
      "--output-dir": "tests/output/tc_t2_structure_retrieval_1",
      "--mock": "true"
    },
    "env": {
      "ADMET_MOCK_PORT": "9021"
    },
    "mock_profile": "empty"
  },
  "assertions": {
    "process": {
      "expected_exit_code": 0,
      "timeout_seconds": 600,
      "stdout_contains": [
        "Pipeline started",
        "Pipeline finished successfully"
      ],
      "stderr_excludes": [
        "Traceback (most recent call last):",
        "AssertionError:"
      ]
    },
    "outputs": [
      {
        "file_path": "tests/output/tc_t2_structure_retrieval_1/target_retriever_output.json",
        "format": "json",
        "json_rules": {
          "schema_validation": true,
          "min_items": 0,
          "check_file_paths_exist": "$[*].structure_path"
        }
      }
    ]
  }
}