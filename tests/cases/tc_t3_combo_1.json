        "AssertionError:"
      ]
    },
    "outputs": [
      {
        "file_path": "tests/output/tc_t3_combo_1/target_retriever_output.json",
        "format": "json",
        "json_rules": {
          "schema_validation": true,
          "min_items": 1
        }
      }
    ]
  }
