  "description": "Validates the combined interaction and intermediate outputs of target_identification and structure_retrieval.",
  "tier": 3,
  "milestone": "M6",
  "feature": "pipeline_integration",
  "input": {
    "disease": "Cystic Fibrosis",
    "args": {
      "--output-dir": "tests/output/tc_t3_combo_1",
      "--mock": "true"
    },
    "env": {
      "ADMET_MOCK_PORT": "9031"
    },
    "mock_profile": "cystic_fibrosis"
  },
  "assertions": {
