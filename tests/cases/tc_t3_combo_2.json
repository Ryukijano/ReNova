{
  "id": "tc_t3_combo_2",
  "name": "Tier 3 - Combo Case 2 (chem_screening + admet_prediction)",
  "description": "Validates the combined interaction and intermediate outputs of chem_screening and admet_prediction.",
  "tier": 3,
  "milestone": "M6",
  "feature": "pipeline_integration",
  "input": {
    "disease": "Alzheimer's Disease",
    "args": {
      "--output-dir": "tests/output/tc_t3_combo_2",
      "--mock": "true"
    },
    "env": {
      "ADMET_MOCK_PORT": "9032"
    },
    "mock_profile": "alzheimers"
  },
  "assertions": {
    "process": {
      "expected_exit_code": 0,
      "timeout_seconds": 600,
      "stdout_contains": [
        "Pipeline started",
        "Pipeline finished successfully"
      ],
      "stderr_excludes": [
        "Traceback (most recent call last):",
        "AssertionError:"
      ]
    },
    "outputs": [
      {
        "file_path": "tests/output/tc_t3_combo_2/chem_screen_output.csv",
        "format": "csv",
        "csv_rules": {
          "required_columns": [
            "gene_symbol",
            "uniprot_id",
            "compound_id",
            "smiles",
            "relation",
            "value",
            "units"
          ],
          "min_row_count": 1,
          "column_validators": {
            "gene_symbol": {
              "type": "string"
            },
            "uniprot_id": {
              "type": "string"
            },
            "compound_id": {
              "type": "string"
            },
            "smiles": {
              "type": "smiles"
            },
            "value": {
              "type": "float",
              "min": 0.0
            },
            "units": {
              "type": "string"
            }
          }
        }
      },
      {
        "file_path": "tests/output/tc_t3_combo_2/admet_predict_output.csv",
        "format": "csv",
        "csv_rules": {
          "required_columns": [
            "gene_symbol",
            "compound_id",
            "smiles",
            "hcl_solubility",
            "caco2_permeability",
            "logp",
            "qed",
            "toxicity_score",
            "admet_score"
          ],
          "min_row_count": 1,
          "column_validators": {
            "gene_symbol": {
              "type": "string"
            },
            "compound_id": {
              "type": "string"
            },
            "smiles": {
              "type": "smiles"
            },
            "hcl_solubility": {
              "type": "float"
            },
            "caco2_permeability": {
              "type": "float"
            },
            "logp": {
              "type": "float"
            },
            "qed": {
              "type": "float",
              "min": 0.0,
              "max": 1.0
            },
            "toxicity_score": {
              "type": "float"
            },
            "admet_score": {
              "type": "float"
            }
          }
        }
      }
    ]
  }
}