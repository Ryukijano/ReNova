{
  "id": "tc_t1_admet_prediction_3",
  "name": "Tier 1 - Admet Prediction Coverage Case 3",
  "description": "Validates admet_prediction under standard mock execution using Malaria.",
  "tier": 1,
  "milestone": "M6",
  "feature": "admet_prediction",
  "input": {
    "disease": "Malaria",
    "args": {
      "--output-dir": "tests/output/tc_t1_admet_prediction_3",
      "--mock": "true"
    },
    "env": {
      "ADMET_MOCK_PORT": "9013"
    },
    "mock_profile": "malaria"
  },
  "assertions": {
    "process": {
      "expected_exit_code": 0,
      "timeout_seconds": 600,
      "stdout_contains": [
        "Pipeline started",
        "Pipeline finished successfully"
      ],
      "stderr_excludes": [
        "Traceback (most recent call last):",
        "AssertionError:"
      ]
    },
    "outputs": [
      {
        "file_path": "tests/output/tc_t1_admet_prediction_3/admet_predict_output.csv",
        "format": "csv",
        "csv_rules": {
          "required_columns": [
            "gene_symbol",
            "compound_id",
            "smiles",
            "hcl_solubility",
            "caco2_permeability",
            "logp",
            "qed",
            "toxicity_score",
            "admet_score"
          ],
          "min_row_count": 1,
          "column_validators": {
            "gene_symbol": {
              "type": "string"
            },
            "compound_id": {
              "type": "string"
            },
            "smiles": {
              "type": "smiles"
            },
            "hcl_solubility": {
              "type": "float"
            },
            "caco2_permeability": {
              "type": "float"
            },
            "logp": {
              "type": "float"
            },
            "qed": {
              "type": "float",
              "min": 0.0,
              "max": 1.0
            },
            "toxicity_score": {
              "type": "float"
            },
            "admet_score": {
              "type": "float"
            }
          }
        }
      }
    ]
  }
}