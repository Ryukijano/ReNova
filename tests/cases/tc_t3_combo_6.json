{
  "id": "tc_t3_combo_6",
  "name": "Tier 3 - Combo Case 6 (chem_screening + clinical_check)",
  "description": "Validates the combined interaction and intermediate outputs of chem_screening and clinical_check.",
  "tier": 3,
  "milestone": "M6",
  "feature": "pipeline_integration",
  "input": {
    "disease": "Cystic Fibrosis",
    "args": {
      "--output-dir": "tests/output/tc_t3_combo_6",
      "--mock": "true"
    },
    "env": {
      "ADMET_MOCK_PORT": "9036"
    },
    "mock_profile": "cystic_fibrosis"
  },
  "assertions": {
    "process": {
      "expected_exit_code": 0,
      "timeout_seconds": 600,
      "stdout_contains": [
        "Pipeline started",
        "Pipeline finished successfully"
      ],
      "stderr_excludes": [
        "Traceback (most recent call last):",
        "AssertionError:"
      ]
    },
    "outputs": [
      {
        "file_path": "tests/output/tc_t3_combo_6/chem_screen_output.csv",
        "format": "csv",
        "csv_rules": {
          "required_columns": [
            "gene_symbol",
            "uniprot_id",
            "compound_id",
            "smiles",
            "relation",
            "value",
            "units"
          ],
          "min_row_count": 1,
          "column_validators": {
            "gene_symbol": {
              "type": "string"
            },
            "uniprot_id": {
              "type": "string"
            },
            "compound_id": {
              "type": "string"
            },
            "smiles": {
              "type": "smiles"
            },
            "value": {
              "type": "float",
              "min": 0.0
            },
            "units": {
              "type": "string"
            }
          }
        }
      },
      {
        "file_path": "tests/output/tc_t3_combo_6/repurposing_candidate_report.csv",
        "format": "csv",
        "csv_rules": {
          "required_columns": [
            "compound_name",
            "compound_id",
            "smiles",
            "target_gene",
            "admet_score",
            "fda_approval_status",
            "clinical_trials_count",
            "adverse_events_count"
          ],
          "min_row_count": 1,
          "column_validators": {
            "compound_name": {
              "type": "string"
            },
            "compound_id": {
              "type": "string"
            },
            "smiles": {
              "type": "smiles"
            },
            "target_gene": {
              "type": "string"
            },
            "admet_score": {
              "type": "float"
            },
            "fda_approval_status": {
              "type": "string"
            },
            "clinical_trials_count": {
              "type": "int",
              "min": 0
            },
            "adverse_events_count": {
              "type": "int",
              "min": 0
            }
          }
        }
      }
    ]
  }
}